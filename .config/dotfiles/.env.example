# Copy this file to .env and fill in real values. This repo is a bare repo
# with `status.showUntrackedFiles no` set locally (see .github/README.md), so
# .env stays untracked without needing a .gitignore.
# Loaded by Taskfile.yml via `dotenv:` and used for git identity, SSH key
# generation (comment + encryption passphrase), etc.

GIT_NAME=
GIT_EMAIL=
SSH_KEY_PASSPHRASE=
