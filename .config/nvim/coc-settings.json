{
  "extensions.updateCheck": "weekly",
  "suggest.completionItemKindLabels": {
    "text": "t",
    "method": "m",
    "function": "f",
    "enum": "E",
    "struct": "S",
    "snippet": "S",
    "class": "C",
    "constructor": "Ct",
    "interface": "I",
    "module": "M",
    "typeParameter": "T",
    "field": "m_",
    "property": "m_",
    "enumMember": "m_E",
    "variable": "v",
    "constant": "k",
    "unit": "U",
    "color": "clr",
    "value": "val",
    "keyword": "key",
    "file": "file",
    "reference": "ref",
    "folder": "fldr",
    "event": "evnt",
    "operator": "op",
    "default": ""
  },
  "suggest.autoTrigger": "always",
  "suggest.minTriggerInputLength": 3,
  "suggest.noselect": false,
  // coc and ALE split the work; ALE draws every diagnostic, so coc hands its
  // LSP diagnostics over to ALE instead of drawing its own signs.
  "diagnostic.displayByAle": true,
  // Off by default: most filetypes get their diagnostics from an ALE linter.
  // The language-scoped section below turns coc back on for the filetypes
  // whose g:ale_linters entry is an empty list.
  "diagnostic.enable": false,
  "[c][cpp][javascript][json][sql][typescript]": {
    "diagnostic.enable": true
  },
  "diagnostic.checkCurrentLine": true,
  "diagnostic.messageTarget": "echo",
  "diagnostic.signPriority": 9999999,
  "snippets.userSnippetsDirectory": "~/.config/nvim/UltiSnips",
  "snippets.ultisnips.directories": [
    "UltiSnips"
  ],
  "snippets.ultisnips.pythonPrompt": false,
  "snippets.loadFromExtensions": true,
  "inlayHint.enable": true,
  "inlayHint.enableParameter": false,
  // ALE formats html with html-beautify, so the language server must not.
  "html.format.enable": false,
  "html.filetypes": [
    "html",
    "handlebars",
    "htmldjango",
    "blade",
    "html.jinja",
    "jinja.html",
    "htmljinja"
  ],
  "html.validate.styles": false,
  "html.validate.scripts": false,
  "html.autoClosingTags": false,
  // htmldjango has no ALE fixer; coc runs djlint on save (see coc_fix_on_save).
  "htmldjango.formatting.provider": "djlint",
  "htmldjango.djlint.addFormatterArgs": [
    "--indent 2",
    "--max-blank-lines 1",
    "--max-line-length 120",
    "--profile django"
  ],
  "htmldjango.djlint.formatJs": true,
  "htmldjango.djlint.formatCss": true,
  "tsserver.enable": true,
  "cmake.lsp.enable": true,
  "sql.database": "postgresql",
  "clangd.arguments": [
    "--header-insertion=never"
  ],
  "clangd.compilationDatabaseCandidates": [
    "${workspaceFolder}/debug",
    "${workspaceFolder}/Debug",
    "${workspaceFolder}/build-aarch64",
    "${workspaceFolder}/build",
    "${workspaceFolder}/Build"
  ],
  "go.checkForUpdates": "disabled"
}
