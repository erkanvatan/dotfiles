#!/usr/bin/env bash
# ----------------
# @file config-fzf
# @author erkanvatan
# @date 2025-02-04
# @brief List dotfiles tracked in .dotfiles bare repository using FZF
#        in multi-select mode. You can select multiple files with <TAB>.
#        Selected files are printed to stdout, one absolute path per line.
#        Prints nothing and exits non-zero when the selection is cancelled.
#
# @depend fzf
# @depend git
# ----------------

set -uo pipefail

readonly GIT_BIN="/usr/bin/git"
readonly GIT_DIR="$HOME/.dotfiles"

if ! selection="$("$GIT_BIN" --git-dir="$GIT_DIR" --work-tree="$HOME" \
    ls-tree --name-only -r --full-name HEAD | sort | fzf --multi)"; then
    exit 1
fi

# fzf can succeed with an empty selection, so guard before printing
[[ -n "$selection" ]] || exit 1

while IFS= read -r file; do
    printf '%s\n' "$HOME/$file"
done <<<"$selection"
