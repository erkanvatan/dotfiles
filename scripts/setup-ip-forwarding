#!/usr/bin/env bash
# -------------------------
# @file setup-ip-forwarding
# @author erkanvatan
# @date 2025-08-11
# @brief Share the source interface's connection with the destination
#        interface: enable IPv4 forwarding and add the NAT/forward iptables
#        rules for it. Rules are added only when missing, so re-running is
#        safe. They live in the running kernel only and are lost on reboot.
# @usage setup-ip-forwarding -s SRC_IFACE -d DEST_IFACE
#
# @depend iptables
# @depend procps
# @depend util-linux
# -------------------------

set -Euo pipefail

function handle_err() {
    echo "An error has occured at line $1, exiting the script..." >&2
    exit "$2"
}

trap 'handle_err $LINENO $?' ERR

src_iface=""
dest_iface=""

function show_help() {
    cat <<USAGE
Setup IP forwarding between network interfaces

Usage: ${0##*/} [OPTIONS]

Options:
  -h, --help
        show this help message
  -s, --src-iface=IFACE
        set source interface, the one with the connection (REQUIRED)
  -d, --dest-iface=IFACE
        set destination interface, the one being shared to (REQUIRED)
USAGE
}

function parse_options() {
    local opts

    # getopt's own exit code has to be read here, before anything else runs
    if ! opts="$(getopt -o hs:d: -l help,src-iface:,dest-iface: -n "${0##*/}" -- "$@")"; then
        show_help
        exit 1
    fi

    eval set -- "$opts"

    while true; do
        case "$1" in
            -h|--help)
                show_help
                exit 0
                ;;
            -s|--src-iface)
                src_iface="$2"
                shift 2
                ;;
            -d|--dest-iface)
                dest_iface="$2"
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                echo "Error: getopt failed." >&2
                exit 1
                ;;
        esac
    done

    if [[ -z "$src_iface" || -z "$dest_iface" ]]; then
        show_help
        exit 1
    fi
}

function require_iface() {
    local -r iface="$1"

    [[ -e "/sys/class/net/$iface" ]] || {
        echo "Error: no such network interface: $iface" >&2
        exit 1
    }
}

# Add an iptables rule only if an identical one is not already installed,
# otherwise every run would append a duplicate. Takes: <table> <chain> <rule...>
# (-A and -C both want the chain as their own argument, so -t goes first).
function ensure_rule() {
    local -r table="$1" chain="$2"
    shift 2
    local -a rule=("$@")

    if sudo iptables -t "$table" -C "$chain" "${rule[@]}" 2>/dev/null; then
        echo "= rule already present: $table $chain ${rule[*]}"
    else
        sudo iptables -t "$table" -A "$chain" "${rule[@]}"
        echo "> added rule: $table $chain ${rule[*]}"
    fi
}

function main() {
    parse_options "$@"

    require_iface "$src_iface"
    require_iface "$dest_iface"

    sudo sysctl -w net.ipv4.ip_forward=1

    ensure_rule filter FORWARD -i "$dest_iface" -o "$src_iface" -j ACCEPT
    ensure_rule filter FORWARD -i "$src_iface" -o "$dest_iface" -m state --state RELATED,ESTABLISHED -j ACCEPT
    ensure_rule nat POSTROUTING -o "$src_iface" -j MASQUERADE
}

main "$@"
